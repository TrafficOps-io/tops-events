{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "trafficops/tops-events",
    "description": "Event catalogs, outbound delivery adapters and Eloquent event journals.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/trafficops-io/tops-events",
    "keywords": [
        "trafficops",
        "laravel",
        "php"
    ],
    "support": {
        "issues": "https://github.com/trafficops-io/tops-events/issues",
        "source": "https://github.com/trafficops-io/tops-events"
    },
    "require": {
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/bus": "^12.0",
        "illuminate/cache": "^12.0",
        "illuminate/contracts": "^12.0",
        "illuminate/database": "^12.0",
        "illuminate/encryption": "^12.0",
        "illuminate/queue": "^12.0",
        "illuminate/support": "^12.0",
        "illuminate/validation": "^12.0",
        "php": "^8.4",
        "symfony/http-foundation": "^7.2"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "TrafficOps\\EventCatalog\\": "packages/event-catalog/src/",
            "TrafficOps\\EventDelivery\\": "packages/event-delivery/src/",
            "TrafficOps\\ModelEvents\\": "packages/model-events/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TrafficOps\\EventCatalog\\Tests\\": "packages/event-catalog/tests/",
            "TrafficOps\\EventDelivery\\Tests\\": "packages/event-delivery/tests/",
            "TrafficOps\\ModelEvents\\Tests\\": "packages/model-events/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "format": "pint",
        "check": [
            "@composer validate --strict",
            "@lint",
            "@test"
        ],
        "build": "@composer archive --format=zip --dir=dist"
    },
    "config": {
        "sort-packages": true
    },
    "archive": {
        "exclude": [
            "/.github",
            "/tests",
            "/packages/*/tests",
            "/phpunit.xml",
            "/pint.json",
            "/composer.lock",
            "/dist",
            "/.phpunit*",
            "/.pint*",
            "/.gitignore",
            "/.gitattributes",
            "/vendor",
            "/.git",
            "/.env",
            "/.env.*",
            ".DS_Store"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "TrafficOps\\EventDelivery\\EventDeliveryServiceProvider",
                "TrafficOps\\ModelEvents\\ModelEventsServiceProvider"
            ]
        }
    }
}
